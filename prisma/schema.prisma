generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DATABASE_URL is the pooled connection used at runtime; DIRECT_URL is the
  // unpooled connection Prisma Migrate needs. Works with any Postgres host
  // that distinguishes the two (Neon/Netlify DB, Supabase, etc.) — set both
  // to the same value for a host that doesn't pool.
  directUrl = env("DIRECT_URL")
}

// ─── Product catalog & pipelines ─────────────────────────────────────────────

model Product {
  key             String           @id // PLACEPULSE | PLYMIO | AI_NAVIGATOR | ADVISORY | UNASSIGNED
  name            String
  description     String?
  active          Boolean          @default(true)
  displayOrder    Int              @default(0)
  pipelines       Pipeline[]
  accountProducts AccountProduct[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// Account-level relationship state per product/business line — independent of
// whether a Lead or Opportunity exists yet. Never derive PROSPECT/CUSTOMER/
// PARTNER automatically from Lead/Contact presence; this is set explicitly.
model AccountProduct {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productKey        String
  product           Product  @relation(fields: [productKey], references: [key])
  relationshipState String   @default("PROSPECT")
  // PROSPECT | ENGAGED | OPPORTUNITY | CUSTOMER | PARTNER_PROSPECT | PARTNER | DORMANT
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([accountId, productKey])
  @@index([productKey])
}

model Pipeline {
  id            String          @id // deterministic: pl_<product-key-lower>
  name          String
  productKey    String
  product       Product         @relation(fields: [productKey], references: [key])
  isDefault     Boolean         @default(true)
  active        Boolean         @default(true)
  stages        PipelineStage[]
  opportunities Opportunity[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([productKey])
}

model PipelineStage {
  id                 String        @id // deterministic: st_<pipeline>_<stage-key-lower>
  key                String // IDENTIFIED | QUALIFIED | ...
  name               String
  order              Int
  defaultProbability Int           @default(10)
  isWon              Boolean       @default(false)
  isLost             Boolean       @default(false)
  active             Boolean       @default(true)
  pipelineId         String
  pipeline           Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities      Opportunity[]

  @@unique([pipelineId, key])
  @@index([pipelineId, order])
}

// A user-saved filter combination for a list page. `query` stores the URL
// query string so reopening a view reproduces it exactly.
model SavedView {
  id        String   @id @default(cuid())
  name      String
  page      String // leads | opportunities | accounts | contacts | tasks | activities
  query     String
  createdAt DateTime @default(now())

  @@unique([page, name])
  @@index([page])
}

// ─── Proposal pipeline (meeting → triage → proposal → CRM) ──────────────────

// A sales-call transcript captured from a meeting recorder (Fathom, Fireflies,
// manual paste…). Cheap triage decides whether it warrants a proposal before
// any expensive generation runs.
model MeetingTranscript {
  id            String   @id @default(cuid())
  source        String   @default("MANUAL") // FATHOM | FIREFLIES | WEBHOOK | MANUAL
  externalId    String?  @unique // recorder's id — makes re-delivery idempotent
  title         String
  meetingDate   DateTime
  durationMins  Int?
  attendees     String? // comma-separated emails
  rawTranscript String

  // Triage (Phase 2)
  triageStatus    String    @default("PENDING") // PENDING | QUALIFIED | SKIPPED | FAILED
  triageReason    String?
  triageScore     Int? // 0–100 proposal-worthiness
  detectedProduct String? // canonical product key
  triagedAt       DateTime?

  // Linking into the shared CRM
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  proposals Proposal[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([triageStatus])
  @@index([meetingDate])
}

// A proposal moving through the generation pipeline. Mirrors the phases:
// analyse transcript → research client → write → format → human review →
// deliver (creates/links a CRM Opportunity).
model Proposal {
  id             String   @id @default(cuid())
  title          String
  product        String   @default("UNASSIGNED") // canonical product key
  stage          String   @default("QUEUED")
  // QUEUED | ANALYZING | RESEARCHING | DRAFTING | FORMATTING | REVIEW | APPROVED | DELIVERED | ARCHIVED
  stageChangedAt DateTime @default(now())

  // Generated artifacts, one per pipeline skill
  requirements String? // Transcript Analyzer output
  research     String? // Client Research output
  draftContent String? // Proposal Writer output (markdown)
  formatted    String? // Proposal Formatter output (final markdown)

  estimatedValue Float?
  clientName     String?
  notes          String?
  failureReason  String?
  emailDraft     String? // draft cover email — never auto-sent
  quotedPricing  String? // pricing actually stated on the call — overrides the catalogue

  // Provenance: which engine produced the content
  generatedBy String? // ANTHROPIC | TEMPLATE

  transcriptId  String?
  transcript    MeetingTranscript? @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  accountId     String?
  account       Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  ownerId       String?
  owner         TeamMember?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  events    ProposalEvent[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([stage])
  @@index([product])
  @@index([ownerId])
}

// The "binder" the proposal writer works from: service catalogue, document
// template, brand guidelines and past winning proposals. Instructions alone
// produce generic output — this is the context half of the system.
model ProposalKnowledge {
  id        String   @id @default(cuid())
  kind      String // SERVICE_CATALOG | TEMPLATE | BRAND | WINNING_EXAMPLE
  title     String
  content   String
  product   String? // null = applies to every business line
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([product])
}

// Append-only audit trail of every pipeline stage run.
model ProposalEvent {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  stage      String
  status     String // STARTED | COMPLETED | FAILED
  detail     String?
  createdAt  DateTime @default(now())

  @@index([proposalId, createdAt])
}

// ─── Team ────────────────────────────────────────────────────────────────────

model TeamMember {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  role          String        @default("SALES_EXECUTIVE") // SALES_DIRECTOR | SALES_EXECUTIVE | VIEWER
  active        Boolean       @default(true)
  leads         Lead[]
  opportunities Opportunity[]
  tasks         Task[]
  activities    Activity[]
  accounts      Account[]
  proposals     Proposal[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ─── Core records ────────────────────────────────────────────────────────────

model Lead {
  id                     String              @id @default(cuid())
  name                   String
  company                String?
  title                  String?
  email                  String?
  phone                  String?
  markets                String              @default("AE") // comma-separated market codes
  sector                 String?
  primaryProduct         String              @default("UNASSIGNED") // canonical product key
  secondaryProducts      String? // comma-separated product keys (cross-sell interest)
  digitalMaturity        String? // LOW | MEDIUM | HIGH
  source                 String? // legacy free-text source — superseded by sourceType/sourceDetail; kept for pre-migration records, no longer written by the UI
  sourceType             String? // EVENT | REFERRAL | INBOUND | OUTBOUND | PARTNER | EXISTING_RELATIONSHIP | LINKEDIN | WEBSITE | OTHER — provenance of the lead. Distinct from salesMotion (how we sell it).
  sourceDetail           String? // free text detail for sourceType, e.g. "ATM Dubai 2026"
  salesMotion            String? // DIRECT | PARTNER | REFERRAL | INVESTOR | INBOUND | OUTBOUND | EVENT | EXISTING_RELATIONSHIP | OTHER
  useCase                String? // suggested-but-extensible use case / context, e.g. "AIRPORT_INTELLIGENCE" — see USE_CASES in src/lib/constants.ts. Shared shape across all products, never product-specific columns on Account/Contact.
  tags                   String?
  status                 String              @default("NEW") // NEW | CONTACTED | QUALIFIED | DISQUALIFIED
  score                  Int?
  estimatedValue         Float?
  // Denormalized summary only — NOT the source of truth for "what's next".
  // Activity = historical interaction record. Task = future commitment.
  // UI should prefer the nearest open Task for "Next Interaction" where practical
  // (see src/lib/nextInteraction.ts) and fall back to this field when no open task exists.
  nextAction             String?
  nextActionDate         DateTime?
  lastActivityAt         DateTime?
  notes                  String?
  convertedOpportunityId String?
  // status values: NEW | CONTACTED | ENGAGED | QUALIFIED | DISQUALIFIED.
  // CONVERTED is never stored here — it's derived at read time from
  // convertedOpportunityId being non-null (see src/lib/nextInteraction.ts
  // sibling helpers), so the two can never drift out of sync.
  accountId              String?
  account                Account?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  primaryContactId       String?
  primaryContact         Contact?            @relation("LeadPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  ownerId                String?
  owner                  TeamMember?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  activities             Activity[]
  tasks                  Task[]
  transcripts            MeetingTranscript[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([primaryProduct])
  @@index([status])
  @@index([ownerId])
  @@index([sourceType])
  @@index([sourceDetail])
  @@index([useCase])
  @@index([accountId])
  @@index([primaryContactId])
}

model Account {
  id              String              @id @default(cuid())
  name            String              @unique
  industry        String?
  country         String              @default("AE")
  sector          String              @default("PRIVATE")
  size            String?
  tier            String? // STRATEGIC | KEY | STANDARD
  locationsCount  Int?
  pastEngagements String?
  website         String?
  description     String?
  ownerId         String?
  owner           TeamMember?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  contacts        Contact[]
  leads           Lead[]
  opportunities   Opportunity[]
  activities      Activity[]
  tasks           Task[]
  transcripts     MeetingTranscript[]
  proposals       Proposal[]
  accountProducts AccountProduct[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([ownerId])
}

model Contact {
  id                    String               @id @default(cuid())
  firstName             String
  lastName              String
  email                 String?              @unique
  phone                 String?
  linkedin              String?
  title                 String?
  role                  String? // organizational/buying role — unchanged: DECISION_MAKER | INFLUENCER | CHAMPION | BLOCKER | OTHER
  // Relationship warmth/status is a distinct axis from `role` (buying
  // authority) — a contact can be role=UNKNOWN and relationshipStrength=
  // INTERNAL_CONNECTOR at the same time. Never reassign existing `role`
  // values based on this field.
  relationshipStrength  String? // COLD | REFERRED | MET | ENGAGED | INTERNAL_CONNECTOR | POTENTIAL_CHAMPION | CHAMPION
  // Provenance — mirrors Lead.sourceType/sourceDetail so contacts that exist
  // before or without a Lead (e.g. a referral chain) still carry provenance.
  sourceType            String? // EVENT | REFERRAL | INBOUND | OUTBOUND | PARTNER | EXISTING_RELATIONSHIP | LINKEDIN | WEBSITE | OTHER
  sourceDetail          String? // free text, e.g. "ATM Dubai 2026"
  acquisitionPath       String? // DIRECT_MEETING | INTERNAL_REFERRAL | STAND_REFERRAL | CARD_PROVIDED | INTRODUCTION | COLD_TARGET | EXISTING_RELATIONSHIP
  referredById          String?
  referredBy            Contact?             @relation("ContactReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals             Contact[]            @relation("ContactReferral")
  accountId             String
  account               Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  opportunities         OpportunityContact[]
  leadsAsPrimaryContact Lead[]               @relation("LeadPrimaryContact")
  activities            Activity[]
  tasks                 Task[]
  transcripts           MeetingTranscript[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([referredById])
  @@index([relationshipStrength])
}

model Opportunity {
  id                   String               @id @default(cuid())
  name                 String
  product              String               @default("UNASSIGNED") // canonical product key — exactly one per opportunity
  type                 String? // COMMERCIAL | STRATEGIC_PARTNERSHIP | DATA_API_PARTNERSHIP | REFERRAL_ECOSYSTEM | OTHER — independent of pipeline stage
  pipelineId           String?
  pipeline             Pipeline?            @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stageId              String?
  stageRef             PipelineStage?       @relation(fields: [stageId], references: [id], onDelete: SetNull)
  stage                String               @default("IDENTIFIED") // stage key (kept in sync with stageRef)
  stageChangedAt       DateTime             @default(now())
  value                Float?
  probability          Int?
  markets              String               @default("AE")
  forecastCategory     String               @default("PIPELINE") // PIPELINE | BEST_CASE | COMMIT | CLOSED
  healthStatus         String               @default("ON_TRACK") // ON_TRACK | AT_RISK | STALLED
  useCase              String? // suggested-but-extensible use case / context, e.g. "AIRPORT_INTELLIGENCE" — see USE_CASES in src/lib/constants.ts
  // Denormalized summary only — NOT the source of truth for "what's next".
  // Activity = historical interaction record. Task = future commitment.
  // UI should prefer the nearest open Task for "Next Interaction" where practical
  // (see src/lib/nextInteraction.ts) and fall back to this field when no open task exists.
  nextAction           String?
  nextActionDate       DateTime?
  expectedCloseDate    DateTime?
  closedAt             DateTime?
  decisionMakerEngaged Boolean              @default(false)
  notes                String?
  ownerId              String?
  owner                TeamMember?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  accountId            String
  account              Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contacts             OpportunityContact[]
  activities           Activity[]
  tasks                Task[]
  proposals            Proposal[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([product])
  @@index([stageId])
  @@index([ownerId])
  @@index([accountId])
  @@index([useCase])
  @@index([type])
}

// The sole source of truth for opportunity stakeholders. The "primary
// contact" shown on an Opportunity is always derived by reading
// isPrimary=true here — never store a separate primaryContactId on
// Opportunity, which would create a second, competing source of truth.
// Application/service code enforces at most one isPrimary=true row per
// opportunityId (see src/lib/opportunityContacts.ts).
model OpportunityContact {
  opportunityId   String
  contactId       String
  isPrimary       Boolean     @default(false)
  stakeholderRole String? // free text, e.g. "Technical Evaluator", "Sponsor"
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contact         Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([opportunityId, contactId])
}

// The canonical historical interaction record — every touchpoint with an
// account/contact/lead/opportunity is logged here. Never create a second,
// overlapping interaction model; extend `type` instead.
model Activity {
  id            String       @id @default(cuid())
  type          String // MEETING | CALL | EMAIL | WHATSAPP | LINKEDIN | DEMO | EVENT_INTERACTION | NOTE | OTHER
  subject       String
  notes         String?
  date          DateTime     @default(now())
  product       String? // explicit product when only account/contact context exists
  ownerId       String?
  owner         TeamMember?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  accountId     String?
  account       Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  // Sprint 06D — set only on type=EMAIL activities created by the approved-send
  // route (src/app/api/email/send). Never set for manually logged activities.
  // idempotencyKey: the client-generated key for one Approve & Send attempt —
  // enforces that a retried/duplicated request records at most one Activity.
  // providerMessageId: Zoho's returned message id, kept for audit only; never
  // required for anything else to function.
  idempotencyKey String?      @unique
  providerMessageId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([product])
  @@index([date])
}

// The canonical future commitment — "what's next" for a record. Lists and
// detail pages should derive "Next Interaction" from the nearest open Task
// (see src/lib/nextInteraction.ts) rather than inventing another field.
model Task {
  id            String       @id @default(cuid())
  title         String
  notes         String?
  // Internal follow-up target — when ArqOne intends to act, set unilaterally
  // by the team. Never implies the client agreed to or requested this date.
  dueDate       DateTime?
  // Externally agreed date — only ever set when the client has actually
  // committed to a specific date. Distinct on purpose from dueDate so an
  // internal deadline is never presented as something the client promised.
  clientCommitmentDate DateTime?
  status        String       @default("OPEN") // OPEN | DONE
  priority      String       @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  product       String? // explicit product when only account/contact context exists
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  accountId     String?
  account       Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  ownerId       String?
  owner         TeamMember?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([product])
  @@index([status])
  @@index([dueDate])
}
