generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DATABASE_URL is the pooled connection used at runtime; DIRECT_URL is the
  // unpooled connection Prisma Migrate needs. Works with any Postgres host
  // that distinguishes the two (Neon/Netlify DB, Supabase, etc.) — set both
  // to the same value for a host that doesn't pool.
  directUrl = env("DIRECT_URL")
}

// ─── Product catalog & pipelines ─────────────────────────────────────────────

model Product {
  key          String     @id // PLACEPULSE | PLYMIO | AI_NAVIGATOR | ADVISORY | UNASSIGNED
  name         String
  description  String?
  active       Boolean    @default(true)
  displayOrder Int        @default(0)
  pipelines    Pipeline[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Pipeline {
  id            String          @id // deterministic: pl_<product-key-lower>
  name          String
  productKey    String
  product       Product         @relation(fields: [productKey], references: [key])
  isDefault     Boolean         @default(true)
  active        Boolean         @default(true)
  stages        PipelineStage[]
  opportunities Opportunity[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([productKey])
}

model PipelineStage {
  id                 String        @id // deterministic: st_<pipeline>_<stage-key-lower>
  key                String // IDENTIFIED | QUALIFIED | ...
  name               String
  order              Int
  defaultProbability Int           @default(10)
  isWon              Boolean       @default(false)
  isLost             Boolean       @default(false)
  active             Boolean       @default(true)
  pipelineId         String
  pipeline           Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities      Opportunity[]

  @@unique([pipelineId, key])
  @@index([pipelineId, order])
}

// A user-saved filter combination for a list page. `query` stores the URL
// query string so reopening a view reproduces it exactly.
model SavedView {
  id        String   @id @default(cuid())
  name      String
  page      String // leads | opportunities | accounts | contacts | tasks | activities
  query     String
  createdAt DateTime @default(now())

  @@unique([page, name])
  @@index([page])
}

// ─── Proposal pipeline (meeting → triage → proposal → CRM) ──────────────────

// A sales-call transcript captured from a meeting recorder (Fathom, Fireflies,
// manual paste…). Cheap triage decides whether it warrants a proposal before
// any expensive generation runs.
model MeetingTranscript {
  id            String   @id @default(cuid())
  source        String   @default("MANUAL") // FATHOM | FIREFLIES | WEBHOOK | MANUAL
  externalId    String?  @unique // recorder's id — makes re-delivery idempotent
  title         String
  meetingDate   DateTime
  durationMins  Int?
  attendees     String? // comma-separated emails
  rawTranscript String

  // Triage (Phase 2)
  triageStatus    String  @default("PENDING") // PENDING | QUALIFIED | SKIPPED | FAILED
  triageReason    String?
  triageScore     Int? // 0–100 proposal-worthiness
  detectedProduct String? // canonical product key
  triagedAt       DateTime?

  // Linking into the shared CRM
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  proposals Proposal[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([triageStatus])
  @@index([meetingDate])
}

// A proposal moving through the generation pipeline. Mirrors the phases:
// analyse transcript → research client → write → format → human review →
// deliver (creates/links a CRM Opportunity).
model Proposal {
  id      String @id @default(cuid())
  title   String
  product String @default("UNASSIGNED") // canonical product key
  stage   String @default("QUEUED")
  // QUEUED | ANALYZING | RESEARCHING | DRAFTING | FORMATTING | REVIEW | APPROVED | DELIVERED | ARCHIVED
  stageChangedAt DateTime @default(now())

  // Generated artifacts, one per pipeline skill
  requirements String? // Transcript Analyzer output
  research     String? // Client Research output
  draftContent String? // Proposal Writer output (markdown)
  formatted    String? // Proposal Formatter output (final markdown)

  estimatedValue Float?
  clientName     String?
  notes          String?
  failureReason  String?
  emailDraft     String? // draft cover email — never auto-sent
  quotedPricing  String? // pricing actually stated on the call — overrides the catalogue

  // Provenance: which engine produced the content
  generatedBy String? // ANTHROPIC | TEMPLATE

  transcriptId  String?
  transcript    MeetingTranscript? @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  accountId     String?
  account       Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  ownerId       String?
  owner         TeamMember?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  events    ProposalEvent[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([stage])
  @@index([product])
  @@index([ownerId])
}

// The "binder" the proposal writer works from: service catalogue, document
// template, brand guidelines and past winning proposals. Instructions alone
// produce generic output — this is the context half of the system.
model ProposalKnowledge {
  id        String   @id @default(cuid())
  kind      String // SERVICE_CATALOG | TEMPLATE | BRAND | WINNING_EXAMPLE
  title     String
  content   String
  product   String? // null = applies to every business line
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([product])
}

// Append-only audit trail of every pipeline stage run.
model ProposalEvent {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  stage      String
  status     String // STARTED | COMPLETED | FAILED
  detail     String?
  createdAt  DateTime @default(now())

  @@index([proposalId, createdAt])
}

// ─── Team ────────────────────────────────────────────────────────────────────

model TeamMember {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  role          String        @default("SALES_EXECUTIVE") // SALES_DIRECTOR | SALES_EXECUTIVE | VIEWER
  active        Boolean       @default(true)
  leads         Lead[]
  opportunities Opportunity[]
  tasks         Task[]
  activities    Activity[]
  accounts      Account[]
  proposals     Proposal[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ─── Core records ────────────────────────────────────────────────────────────

model Lead {
  id                     String      @id @default(cuid())
  name                   String
  company                String?
  title                  String?
  email                  String?
  phone                  String?
  markets                String      @default("AE") // comma-separated market codes
  sector                 String?
  primaryProduct         String      @default("UNASSIGNED") // canonical product key
  secondaryProducts      String? // comma-separated product keys (cross-sell interest)
  digitalMaturity        String? // LOW | MEDIUM | HIGH
  source                 String?
  salesMotion            String? // DIRECT | PARTNER | REFERRAL | INVESTOR | INBOUND | OUTBOUND | EVENT | EXISTING_RELATIONSHIP | OTHER
  tags                   String?
  status                 String      @default("NEW") // NEW | CONTACTED | QUALIFIED | DISQUALIFIED
  score                  Int?
  estimatedValue         Float?
  nextAction             String?
  nextActionDate         DateTime?
  lastActivityAt         DateTime?
  notes                  String?
  convertedOpportunityId String?
  ownerId                String?
  owner                  TeamMember? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  activities             Activity[]
  tasks                  Task[]
  transcripts            MeetingTranscript[]
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([primaryProduct])
  @@index([status])
  @@index([ownerId])
}

model Account {
  id              String        @id @default(cuid())
  name            String        @unique
  industry        String?
  country         String        @default("AE")
  sector          String        @default("PRIVATE")
  size            String?
  tier            String? // STRATEGIC | KEY | STANDARD
  locationsCount  Int?
  pastEngagements String?
  website         String?
  description     String?
  ownerId         String?
  owner           TeamMember?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  contacts        Contact[]
  opportunities   Opportunity[]
  activities      Activity[]
  tasks           Task[]
  transcripts     MeetingTranscript[]
  proposals       Proposal[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([ownerId])
}

model Contact {
  id            String               @id @default(cuid())
  firstName     String
  lastName      String
  email         String?              @unique
  phone         String?
  linkedin      String?
  title         String?
  role          String? // DECISION_MAKER | INFLUENCER | CHAMPION | BLOCKER | OTHER
  accountId     String
  account       Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  opportunities OpportunityContact[]
  activities    Activity[]
  tasks         Task[]
  transcripts   MeetingTranscript[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model Opportunity {
  id                   String               @id @default(cuid())
  name                 String
  product              String               @default("UNASSIGNED") // canonical product key — exactly one per opportunity
  pipelineId           String?
  pipeline             Pipeline?            @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stageId              String?
  stageRef             PipelineStage?       @relation(fields: [stageId], references: [id], onDelete: SetNull)
  stage                String               @default("IDENTIFIED") // stage key (kept in sync with stageRef)
  stageChangedAt       DateTime             @default(now())
  value                Float?
  probability          Int?
  markets              String               @default("AE")
  forecastCategory     String               @default("PIPELINE") // PIPELINE | BEST_CASE | COMMIT | CLOSED
  healthStatus         String               @default("ON_TRACK") // ON_TRACK | AT_RISK | STALLED
  nextAction           String?
  nextActionDate       DateTime?
  expectedCloseDate    DateTime?
  closedAt             DateTime?
  decisionMakerEngaged Boolean              @default(false)
  notes                String?
  ownerId              String?
  owner                TeamMember?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  accountId            String
  account              Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contacts             OpportunityContact[]
  activities           Activity[]
  tasks                Task[]
  proposals            Proposal[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([product])
  @@index([stageId])
  @@index([ownerId])
  @@index([accountId])
}

model OpportunityContact {
  opportunityId String
  contactId     String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([opportunityId, contactId])
}

model Activity {
  id            String       @id @default(cuid())
  type          String // MEETING | CALL | EMAIL | NOTE | DEMO
  subject       String
  notes         String?
  date          DateTime     @default(now())
  product       String? // explicit product when only account/contact context exists
  ownerId       String?
  owner         TeamMember?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  accountId     String?
  account       Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([product])
  @@index([date])
}

model Task {
  id            String       @id @default(cuid())
  title         String
  notes         String?
  dueDate       DateTime?
  status        String       @default("OPEN") // OPEN | DONE
  priority      String       @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  product       String? // explicit product when only account/contact context exists
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  accountId     String?
  account       Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  ownerId       String?
  owner         TeamMember?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([product])
  @@index([status])
  @@index([dueDate])
}
