# Copy this file to .env and fill in real values for local development.
# On Netlify, set these as Site environment variables instead — do not
# commit real secrets to the repo.

# Postgres connection string (Supabase: Project Settings → Database →
# Connection string → "Transaction" pooler, recommended for serverless).
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Optional but recommended if DATABASE_URL above is a pooled (pgbouncer)
# connection: Prisma Migrate needs a *direct* (non-pooled) connection to run
# migrations. Supabase: same page, "Session" pooler or the direct connection
# on port 5432. Leave unset to use DATABASE_URL for migrations too.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Stopgap shared-password gate (HTTP Basic Auth) protecting the whole app
# until per-user Supabase Auth ships. Any username works; only the password
# is checked. Leave CRM_ACCESS_PASSWORD unset to disable the gate (e.g. for
# local development).
CRM_ACCESS_PASSWORD="change-me"
