# Copy this file to .env and fill in real values for local development.
# On Netlify, set these as Site environment variables instead — do not
# commit real secrets to the repo.

# Postgres connection string. Recommended: Netlify DB (Neon-backed, free
# tier) — on the site's "Database" tab, provision it and Netlify generates
# the connection strings for you. Copy the pooled one here.
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]/[DB]?sslmode=require"

# Optional but recommended if DATABASE_URL above is a pooled connection:
# Prisma Migrate needs a *direct* (unpooled) connection to run migrations.
# Netlify DB / Neon: the same Database tab gives you both a pooled and an
# unpooled string — use the unpooled one here. Leave unset to use
# DATABASE_URL for migrations too.
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[HOST]/[DB]?sslmode=require"

# Stopgap shared-password gate (HTTP Basic Auth) protecting the whole app
# until per-user auth ships. Any username works; only the password is
# checked. Leave CRM_ACCESS_PASSWORD unset to disable the gate (e.g. for
# local development).
CRM_ACCESS_PASSWORD="change-me"

# Optional — the Sales Copilot's "Draft follow-up email" falls back to a
# deterministic template without this; set it to use real Anthropic
# generation instead.
ANTHROPIC_API_KEY=""

# Quick Capture structured debrief extraction only. Set server-side in
# Netlify production; never expose this value to browser code.
OPENAI_API_KEY=""

# Optional — Sprint 06D outbound email (Zoho Mail). All five must be set
# together to enable "Approve & Send"; leave any unset and sending stays
# disabled (drafting/Copy/Save as note all still work). See the Sprint 06D
# report for how to obtain these from Zoho's API Console. Never commit real
# values — set these as Site environment variables on Netlify instead.
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_ACCOUNT_ID=""
# The mailbox address Piero sends from — must be the mailbox the above
# credentials belong to; the app never lets a caller choose a different From.
ZOHO_FROM_ADDRESS=""
# Zoho data-center suffix for your account's region: com | eu | in | com.au | jp.
# Defaults to "com" (zoho.com) when unset.
ZOHO_DATA_CENTER="com"

# Sprint 4 email foundation. Every capability fails closed and remains inert
# unless a later, separately approved release explicitly enables it.
EMAIL_READ_SYNC_ENABLED="false"
EMAIL_ZOHO_WEBHOOK_ENABLED="false"
EMAIL_RELATIONSHIP_TIMELINE_ENABLED="false"
EMAIL_BODY_RETENTION_ENABLED="false"
EMAIL_SEND_V2_ENABLED="false"

# Sprint 4B read-only pilot design. Keep blank until mailbox/privacy approval.
# These credentials must be a separate least-privilege ZohoMail.messages.READ
# grant; never reuse the outbound sender credentials above.
ZOHO_READ_CLIENT_ID=""
ZOHO_READ_CLIENT_SECRET=""
ZOHO_READ_REFRESH_TOKEN=""
ZOHO_READ_ACCOUNT_ID=""
ZOHO_READ_MAILBOX_ADDRESS=""
ZOHO_READ_DATA_REGION=""
ZOHO_READ_INBOX_FOLDER_ID=""
ZOHO_READ_SENT_FOLDER_ID=""

# Reconciliation defaults. Netlify invokes the disabled worker every 30 minutes
# only on published deploys; previews and branch deploys do not run schedules.
# The interval is fixed at 30 minutes by the Netlify cron declaration.
# Safety limits: at most 5 messages per folder and 1 page per run.
# Raising either limit requires a new performance/rate-limit review and code change.
EMAIL_INITIAL_LOOKBACK_DAYS="30"
EMAIL_RECONCILE_OVERLAP_MINUTES="60"
EMAIL_RECONCILE_PAGE_SIZE="5"
EMAIL_RECONCILE_MAX_PAGES="1"
EMAIL_RETRY_BASE_MINUTES="5"
EMAIL_RETRY_MAX_MINUTES="360"
